{
  "Urls": "http://0.0.0.0:5001",
  "Startup": {
    "ApplicationName": "ServicioUnificado",
    "StopExistingBackBorradorDevOnSamePort": true
  },
  "DatabaseDiagnostics": {
    "LogOnStartup": true,
    "ConnectTimeoutSeconds": 3
  },
  "ConnectionStrings": {
    "SqlServer": "Server=YOUR_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "AllowedHosts": "*"
}
