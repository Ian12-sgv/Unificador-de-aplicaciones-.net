<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Paleta única de la app (ver DESIGN.md en la raíz del repositorio).
        Las pantallas usan estos roles con StaticResource; no escribir colores hexadecimales en las vistas.
        Android usa además Platforms\Android\Resources\values\colors.xml para la barra de estado.
    -->

    <!-- Marca y acción -->
    <Color x:Key="Brand">#1E4855</Color>
    <Color x:Key="BrandDark">#163A45</Color>
    <Color x:Key="Primary">#087A62</Color>
    <Color x:Key="PrimaryPressed">#06604D</Color>
    <Color x:Key="PrimaryContainer">#E3F2EE</Color>
    <Color x:Key="PrimaryOutline">#B3DCD1</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="Price">#C2410C</Color>

    <!-- Superficies y texto -->
    <Color x:Key="Canvas">#F4F6F8</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceMuted">#EAF1F4</Color>
    <Color x:Key="Outline">#D9E1E5</Color>
    <Color x:Key="OutlineStrong">#7D8F96</Color>
    <Color x:Key="TextPrimary">#1D2E35</Color>
    <Color x:Key="TextSecondary">#56676E</Color>

    <!-- Estados -->
    <Color x:Key="Error">#9C2F27</Color>
    <Color x:Key="ErrorContainer">#FDECEA</Color>
    <Color x:Key="ErrorOutline">#F4C7C3</Color>
    <Color x:Key="Warning">#8A5A00</Color>
    <Color x:Key="WarningContainer">#FFF4DB</Color>
    <Color x:Key="WarningOutline">#F2D6A2</Color>
    <Color x:Key="Info">#2E6A8E</Color>
    <Color x:Key="InfoContainer">#E6EFF5</Color>

    <!-- Escala neutra que usan los estilos base de MAUI -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource Brand}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
</ResourceDictionary>
