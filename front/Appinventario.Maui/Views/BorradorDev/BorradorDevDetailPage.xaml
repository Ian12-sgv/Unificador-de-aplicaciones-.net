<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Appinventario.Views.BorradorDev.BorradorDevDetailPage"
             Visual="Material"
             Title="Detalle Borrador"
             BackgroundColor="{StaticResource Canvas}">
    <ContentPage.Content>
        <Grid Padding="10" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Frame Grid.Row="0"
                   Padding="12"
                   CornerRadius="12"
                   HasShadow="False"
                   BorderColor="{StaticResource Outline}"
                   BackgroundColor="{StaticResource Surface}">
                <StackLayout Spacing="4">
                    <Label x:Name="lblHeaderNumero"
                           FontAttributes="Bold"
                           FontSize="{StaticResource FontSubtitle}"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label x:Name="lblHeaderFecha"
                           FontSize="{StaticResource FontCaption}"
                           TextColor="{StaticResource TextSecondary}" />
                    <Label x:Name="lblHeaderUsuario"
                           FontSize="{StaticResource FontCaption}"
                           TextColor="{StaticResource TextSecondary}" />
                    <Label x:Name="lblHeaderObservacion"
                           FontSize="{StaticResource FontCaption}"
                           TextColor="{StaticResource TextSecondary}"
                           LineBreakMode="WordWrap" />
                    <Label x:Name="lblHeaderStatus"
                           FontSize="{StaticResource FontCaption}"
                           TextColor="{StaticResource TextSecondary}" />
                </StackLayout>
            </Frame>

            <Frame Grid.Row="1"
                   x:Name="frameLock"
                   IsVisible="False"
                   Padding="12,10"
                   CornerRadius="10"
                   HasShadow="False"
                   BorderColor="{StaticResource WarningOutline}"
                   BackgroundColor="{StaticResource WarningContainer}">
                <Label x:Name="lblLock"
                       FontSize="{StaticResource FontBody}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Warning}"
                       LineBreakMode="WordWrap" />
            </Frame>

            <Frame Grid.Row="2"
                   x:Name="frameStatus"
                   IsVisible="False"
                   Padding="12,10"
                   CornerRadius="10"
                   HasShadow="False"
                   BorderColor="{StaticResource ErrorOutline}"
                   BackgroundColor="{StaticResource ErrorContainer}">
                <Label x:Name="lblStatus"
                       FontSize="{StaticResource FontBody}"
                       LineBreakMode="WordWrap" />
            </Frame>

            <Grid Grid.Row="3">
                <Label x:Name="lblEmpty"
                       IsVisible="False"
                       FontSize="{StaticResource FontBody}"
                       TextColor="{StaticResource TextSecondary}"
                       Text="No existe un borrador con ese número." />

                <CollectionView x:Name="listDetails"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="12"
                                    BackgroundColor="{StaticResource Surface}"
                                    Stroke="{StaticResource Outline}"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="8">
                                    <FlexLayout Direction="Row"
                                                Wrap="Wrap"
                                                AlignItems="Start"
                                                JustifyContent="Start">
                                        <Border Margin="0,0,8,6"
                                                Padding="8,4"
                                                BackgroundColor="{StaticResource SurfaceMuted}"
                                                Stroke="{StaticResource Outline}"
                                                StrokeThickness="1">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding CodigoDisplay}"
                                                   FontSize="{StaticResource FontCaption}"
                                                   TextColor="{StaticResource Brand}" />
                                        </Border>

                                        <Border Margin="0,0,8,6"
                                                Padding="8,4"
                                                BackgroundColor="{StaticResource SurfaceMuted}"
                                                Stroke="{StaticResource Outline}"
                                                StrokeThickness="1">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding CajaDisplay}"
                                                   FontSize="{StaticResource FontCaption}"
                                                   TextColor="{StaticResource Brand}" />
                                        </Border>
                                    </FlexLayout>

                                    <Label Text="{Binding ReferenciaDisplay}"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding NombreDisplay}"
                                           TextColor="{StaticResource TextSecondary}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />
                                    <Label Text="Cantidad"
                                           FontSize="{StaticResource FontCaption}"
                                           TextColor="{StaticResource TextSecondary}" />
                                    <Entry Text="{Binding CantidadText, Mode=TwoWay}"
                                           Keyboard="Numeric"
                                           IsEnabled="{Binding CanEdit}"
                                           BackgroundColor="{StaticResource Surface}"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="Solo se puede editar cantidad."
                                           FontSize="{StaticResource FontCaption}"
                                           TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <Button Grid.Row="4"
                    x:Name="btnSave"
                    Text="Guardar cambios"
                    Clicked="OnSaveClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource OnPrimary}"
                    CornerRadius="12" />
        </Grid>
    </ContentPage.Content>
</ContentPage>

