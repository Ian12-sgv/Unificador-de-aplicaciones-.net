<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Appinventario.Controls"
             x:Class="Appinventario.Views.BorradorDev.BorradorDevPage"
             Visual="Material"
             Title="Borrador Dev"
             BackgroundColor="{StaticResource Canvas}">
    <ContentPage.Content>
        <Grid Padding="10" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Frame Grid.Row="0"
                   Padding="12,10"
                   CornerRadius="12"
                   HasShadow="False"
                   BorderColor="{StaticResource Outline}"
                   BackgroundColor="{StaticResource SurfaceMuted}">
                <StackLayout Spacing="2">
                    <Label Text="Módulo de borradores de devolución"
                           FontSize="{StaticResource FontCaption}"
                           TextColor="{StaticResource TextSecondary}" />
                    <Label x:Name="lblBaseUrl"
                           FontSize="{StaticResource FontCaption}"
                           TextColor="{StaticResource TextPrimary}" />
                </StackLayout>
            </Frame>

            <Frame Grid.Row="1"
                   x:Name="frameStatus"
                   IsVisible="False"
                   Padding="12,10"
                   CornerRadius="10"
                   HasShadow="False"
                   BorderColor="{StaticResource ErrorOutline}"
                   BackgroundColor="{StaticResource ErrorContainer}">
                <Label x:Name="lblStatus"
                       FontSize="{StaticResource FontBody}"
                       LineBreakMode="WordWrap" />
            </Frame>

            <Grid Grid.Row="2"
                  ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="btnNuevoTop"
                        Text="Nuevo"
                        Clicked="OnNuevoClicked"
                        BackgroundColor="{StaticResource Surface}"
                        TextColor="{StaticResource Brand}"
                        CornerRadius="10"
                        BorderColor="{StaticResource Outline}"
                        BorderWidth="1" />
                <Button Grid.Column="1"
                        x:Name="btnBuscarTop"
                        Text="Buscar"
                        Clicked="OnBuscarClicked"
                        BackgroundColor="{StaticResource Surface}"
                        TextColor="{StaticResource Brand}"
                        CornerRadius="10"
                        BorderColor="{StaticResource Outline}"
                        BorderWidth="1" />
            </Grid>

            <ScrollView Grid.Row="3">
                <StackLayout Spacing="10">
                    <Frame Padding="12"
                           CornerRadius="12"
                           HasShadow="False"
                           BorderColor="{StaticResource Outline}"
                           BackgroundColor="{StaticResource Surface}">
                        <StackLayout Spacing="10">
                            <Label Text="Cabecera"
                                   FontSize="{StaticResource FontSubtitle}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />

                            <Grid ColumnSpacing="10"
                                  RowDefinitions="Auto">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Número"
                                           FontSize="{StaticResource FontCaption}"
                                           TextColor="{StaticResource TextSecondary}" />
                                    <Entry x:Name="txtNumero"
                                           IsReadOnly="True"
                                           Placeholder="Se crea al guardar"
                                           BackgroundColor="{StaticResource Surface}"
                                           TextColor="{StaticResource TextPrimary}" />
                                </StackLayout>

                                <Button Grid.Column="1"
                                        x:Name="btnBuscarNumero"
                                        Text="Buscar"
                                        Clicked="OnBuscarClicked"
                                        VerticalOptions="End"
                                        BackgroundColor="{StaticResource SurfaceMuted}"
                                        TextColor="{StaticResource Brand}"
                                        CornerRadius="10" />

                                <Button Grid.Column="2"
                                        x:Name="btnNuevoNumero"
                                        Text="Nuevo"
                                        Clicked="OnNuevoClicked"
                                        VerticalOptions="End"
                                        BackgroundColor="{StaticResource SurfaceMuted}"
                                        TextColor="{StaticResource Brand}"
                                        CornerRadius="10" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Fecha"
                                           FontSize="{StaticResource FontCaption}"
                                           TextColor="{StaticResource TextSecondary}" />
                                    <DatePicker x:Name="dpFecha"
                                                BackgroundColor="{StaticResource Surface}"
                                                TextColor="{StaticResource TextPrimary}" />
                                </StackLayout>

                                <StackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Usuario"
                                           FontSize="{StaticResource FontCaption}"
                                           TextColor="{StaticResource TextSecondary}" />
                                    <Entry Text="admi"
                                           IsReadOnly="True"
                                           BackgroundColor="{StaticResource Surface}"
                                           TextColor="{StaticResource TextPrimary}" />
                                </StackLayout>
                            </Grid>

                            <StackLayout Spacing="4">
                                <Label Text="Observación"
                                       FontSize="{StaticResource FontCaption}"
                                       TextColor="{StaticResource TextSecondary}" />
                                <Entry x:Name="txtObservacion"
                                       Placeholder="Observación"
                                       BackgroundColor="{StaticResource Surface}"
                                       TextColor="{StaticResource TextPrimary}" />
                            </StackLayout>

                            <Label x:Name="lblMode"
                                   FontSize="{StaticResource FontCaption}"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </StackLayout>
                    </Frame>

                    <Frame Padding="12"
                           CornerRadius="12"
                           HasShadow="False"
                           BorderColor="{StaticResource Outline}"
                           BackgroundColor="{StaticResource Surface}">
                        <StackLayout Spacing="10">
                            <Label Text="Escaneo"
                                   FontSize="{StaticResource FontSubtitle}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />

                            <StackLayout Spacing="4">
                                <Label Text="Código de barra"
                                       FontSize="{StaticResource FontCaption}"
                                       TextColor="{StaticResource TextSecondary}" />
                                <controls:RoundedEntry x:Name="txtCodigoBarra"
                                                       Placeholder="Escanee o escriba aquí"
                                                       TextChanged="BarcodeTextChanged"
                                                       Completed="OnBarcodeCompleted"
                                                       ReturnType="Search"
                                                       HorizontalTextAlignment="Center"
                                                       FontSize="{StaticResource FontHeadline}"
                                                       HeightRequest="56"
                                                       BackgroundColor="{StaticResource Surface}"
                                                       TextColor="{StaticResource TextPrimary}" />
                            </StackLayout>

                            <StackLayout Spacing="4">
                                <Label Text="Caja"
                                       FontSize="{StaticResource FontCaption}"
                                       TextColor="{StaticResource TextSecondary}" />
                                <Entry x:Name="txtNumeroCaja"
                                       Keyboard="Numeric"
                                       Text="1"
                                       Unfocused="OnNumeroCajaUnfocused"
                                       BackgroundColor="{StaticResource Surface}"
                                       TextColor="{StaticResource TextPrimary}" />
                            </StackLayout>

                            <Label Text="Si repite un código en la misma caja, se suma la cantidad."
                                   FontSize="{StaticResource FontCaption}"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </StackLayout>
                    </Frame>
                </StackLayout>
            </ScrollView>

            <Grid Grid.Row="4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="btnGuardar"
                        Text="Guardar"
                        Clicked="OnGuardarClicked"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource OnPrimary}"
                        CornerRadius="12" />
                <Button Grid.Column="1"
                        x:Name="btnAprobar"
                        Text="Aprobar"
                        Clicked="OnAprobarClicked"
                        BackgroundColor="{StaticResource SurfaceMuted}"
                        TextColor="{StaticResource Brand}"
                        CornerRadius="12" />
                <Button Grid.Column="2"
                        x:Name="btnDetalle"
                        Text="Detalle"
                        Clicked="OnDetalleClicked"
                        BackgroundColor="{StaticResource Surface}"
                        TextColor="{StaticResource Brand}"
                        CornerRadius="12"
                        BorderColor="{StaticResource Outline}"
                        BorderWidth="1" />
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>

