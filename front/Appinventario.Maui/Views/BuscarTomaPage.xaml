<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Appinventario.Views.BuscarTomaPage"
             Title="Catálogo">
    <StackLayout>
     <SearchBar x:Name="Search" 
                CancelButtonColor="Blue"
                Placeholder="Buscar"
                PlaceholderColor="Orange"
                HorizontalTextAlignment="Center"
                TextChanged="Search_TextChanged"
                Keyboard="Numeric">
     </SearchBar>
    <CollectionView x:Name="ListToma"
                     SelectionMode="Single"
                     SelectionChanged="Handle_ItemTapped">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <StackLayout>
                    <Label Text="{Binding NumeroPagina}" FontAttributes="Bold"/>
                    <Label Text="{Binding Observacion}" FontSize="Small"/>
                </StackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
    </StackLayout>
</ContentPage>

