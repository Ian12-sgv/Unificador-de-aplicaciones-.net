<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Appinventario.Views.BuscarTomaPage"
             Title="Catálogo">
    <Grid RowDefinitions="Auto,*">
        <SearchBar x:Name="Search"
                   Grid.Row="0"
                   CancelButtonColor="{StaticResource TextSecondary}"
                   Placeholder="Buscar"
                   PlaceholderColor="{StaticResource TextSecondary}"
                   HorizontalTextAlignment="Start"
                   TextChanged="Search_TextChanged"
                   Keyboard="Numeric" />
        <CollectionView x:Name="ListToma"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="Handle_ItemTapped">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding NumeroPagina}"
                           Padding="14,10"
                           FontSize="{StaticResource FontTitle}"
                           TextColor="{StaticResource TextPrimary}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>