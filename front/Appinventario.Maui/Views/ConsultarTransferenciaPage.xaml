<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Appinventario.Views.ConsultarTransferenciaPage"
             Title="Transferencias"
             BackgroundColor="{StaticResource Canvas}">
    <Grid RowDefinitions="Auto,*"
          Padding="8,12,8,0"
          RowSpacing="10">
        <VerticalStackLayout Grid.Row="0"
                             Spacing="8">
            <VerticalStackLayout Spacing="0">
                <Label Text="Transferencias"
                       FontSize="{StaticResource FontTitle}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"/>
                <Label Text="Historial y estado"
                       FontSize="{StaticResource FontBody}"
                       TextColor="{StaticResource TextPrimary}"/>
            </VerticalStackLayout>

            <Border BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Outline}"
                    StrokeThickness="1"
                    Padding="0">
                <Border.StrokeShape>
                    <shapes:RoundRectangle CornerRadius="7"/>
                </Border.StrokeShape>
                <SearchBar x:Name="buscarTransferencia"
                           Placeholder="Buscar por número, sucursal u observación"
                           TextChanged="BuscarTransferencia_TextChanged"
                           BackgroundColor="Transparent"
                           CancelButtonColor="{StaticResource Primary}"
                           FontSize="{StaticResource FontBody}"
                           HeightRequest="48"/>
            </Border>

            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        HeightRequest="52">
                <HorizontalStackLayout Spacing="8">
                    <Button x:Name="btnTodas"
                            Text="Todas"
                            Clicked="FiltroTodas_Clicked"
                            HeightRequest="48"
                            Padding="16,0"
                            FontSize="{StaticResource FontBody}"
                            FontAttributes="Bold"
                            CornerRadius="24"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource OnPrimary}"/>
                    <Button x:Name="btnAbierta"
                            Text="Guardadas"
                            Clicked="FiltroAbierta_Clicked"
                            HeightRequest="48"
                            Padding="16,0"
                            FontSize="{StaticResource FontBody}"
                            FontAttributes="Bold"
                            CornerRadius="24"
                            BackgroundColor="{StaticResource SurfaceMuted}"
                            TextColor="{StaticResource TextSecondary}"/>
                    <Button x:Name="btnConfirmada"
                            Text="Aprobadas"
                            Clicked="FiltroConfirmada_Clicked"
                            HeightRequest="48"
                            Padding="16,0"
                            FontSize="{StaticResource FontBody}"
                            FontAttributes="Bold"
                            CornerRadius="24"
                            BackgroundColor="{StaticResource SurfaceMuted}"
                            TextColor="{StaticResource TextSecondary}"/>
                    <Button x:Name="btnProcesada"
                            Text="Exportadas"
                            Clicked="FiltroProcesada_Clicked"
                            HeightRequest="48"
                            Padding="16,0"
                            FontSize="{StaticResource FontBody}"
                            FontAttributes="Bold"
                            CornerRadius="24"
                            BackgroundColor="{StaticResource SurfaceMuted}"
                            TextColor="{StaticResource TextSecondary}"/>
                </HorizontalStackLayout>
            </ScrollView>

            <Label x:Name="estadoCarga"
                   IsVisible="False"
                   FontSize="{StaticResource FontCaption}"
                   TextColor="{StaticResource Error}"/>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        x:Name="listaTranferencia"
                        SelectionMode="None"
                        ItemsSource="{Binding TransferenciasFiltradas}">
            <CollectionView.EmptyView>
                <Grid Padding="12,40">
                    <Label Text="Sin transferencias para mostrar."
                           FontSize="{StaticResource FontBody}"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource TextSecondary}"/>
                </Grid>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource SurfaceMuted}"
                            StrokeThickness="1"
                            Margin="0,0,0,10"
                            Padding="13,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Transferencia_Tapped"/>
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <shapes:RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Grid RowDefinitions="Auto,Auto,1,Auto"
                              ColumnDefinitions="*,Auto"
                              RowSpacing="8">
                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{Binding NumeroDisplay}"
                                   FontAttributes="Bold"
                                   FontSize="{StaticResource FontBody}"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    BackgroundColor="{Binding EstadoFondo}"
                                    StrokeThickness="0"
                                    Padding="8,3">
                                <Border.StrokeShape>
                                    <shapes:RoundRectangle CornerRadius="4"/>
                                </Border.StrokeShape>
                                <Label Text="{Binding EstadoTexto}"
                                       TextColor="{Binding EstadoColor}"
                                       FontAttributes="Bold"
                                       FontSize="{StaticResource FontCaption}"/>
                            </Border>

                            <VerticalStackLayout Grid.Row="1"
                                                 Grid.ColumnSpan="2"
                                                 Spacing="8">
                                <Label Text="{Binding SucursalNombreDisplay}"
                                       FontSize="{StaticResource FontCaption}"
                                       TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="{Binding ObservacionDisplay}"
                                       FontSize="{StaticResource FontCaption}"
                                       FontAttributes="Italic"
                                       TextColor="{StaticResource TextPrimary}"/>
                            </VerticalStackLayout>

                            <BoxView Grid.Row="2"
                                     Grid.ColumnSpan="2"
                                     HeightRequest="1"
                                     Color="{StaticResource SurfaceMuted}"/>

                            <Grid Grid.Row="3"
                                  Grid.ColumnSpan="2"
                                  ColumnDefinitions="*,*,Auto"
                                  ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding FechaDisplay}"
                                       FontSize="{StaticResource FontCaption}"
                                       TextColor="{StaticResource TextPrimary}"/>
                                <Label Grid.Column="1"
                                       Text="{Binding ResumenItems}"
                                       FontSize="{StaticResource FontCaption}"
                                       TextColor="{StaticResource TextPrimary}"/>
                                <Label Grid.Column="2"
                                       Text=">"
                                       FontSize="{StaticResource FontTitle}"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalTextAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
