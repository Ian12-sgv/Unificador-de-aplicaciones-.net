<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
             x:Class="Appinventario.Views.EliminarTransferenciaPage"
             Visual="Material"
             Title="Eliminar Trasferencia">
    <ContentPage.Content>
        <StackLayout>
            <CollectionView x:Name="listaTranferencia">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout Orientation="Horizontal">
                            <StackLayout HorizontalOptions="StartAndExpand">
                                <Label Text="{Binding Numero}"/>
                                <Label Text="{Binding Observacion}"/>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal">
                                <ImageButton Source="delete.png" Clicked="EliminarTransfer_Clicked"/>
                            </StackLayout>
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
