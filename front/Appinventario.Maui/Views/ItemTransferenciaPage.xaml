<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Appinventario.Views.ItemTransferenciaPage"
             Title="Transferencia">
    <ContentPage.Content>
        <StackLayout>
            <Label Text="Item Details" FontSize="{StaticResource FontHeadline}" HorizontalOptions="Center" />
            <Label Text="Número:" FontAttributes="Bold"/>
            <Label Text="{Binding SelectedItem.Numero}" />
            <Label Text="Observación:" FontAttributes="Bold"/>
            <Label Text="{Binding SelectedItem.Observacion}" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
