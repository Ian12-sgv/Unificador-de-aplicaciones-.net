<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Appinventario.Views.LoginPage"
             Title="Login"
             BackgroundColor="#F4F6F8">
    <ContentPage.Content>
        <Grid Padding="24">
            <Frame VerticalOptions="Center"
                   Padding="18"
                   CornerRadius="14"
                   HasShadow="False"
                   BorderColor="#D9E1E5"
                   BackgroundColor="White">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Acceso"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#24343A"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Ingrese usuario y contraseña"
                           FontSize="13"
                           TextColor="#60727A"
                           HorizontalTextAlignment="Center" />
                    <Entry x:Name="txtUser"
                           Placeholder="Usuario"
                           ReturnType="Next" />
                    <Entry x:Name="txtPassword"
                           Placeholder="Contraseña"
                           IsPassword="True"
                           ReturnType="Go"
                           Completed="OnLoginClicked" />
                    <Button Text="Entrar"
                            Clicked="OnLoginClicked"
                            BackgroundColor="#0B8F72"
                            TextColor="White"
                            CornerRadius="10" />
                    <Label x:Name="lblMessage"
                           IsVisible="False"
                           TextColor="#9C2F27"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </ContentPage.Content>
</ContentPage>
