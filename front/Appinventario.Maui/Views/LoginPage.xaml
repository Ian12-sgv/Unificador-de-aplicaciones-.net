<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Appinventario.Views.LoginPage"
             Title="Acceso"
             BackgroundColor="{StaticResource Canvas}">
    <ContentPage.Content>
        <Grid Padding="24">
            <Frame VerticalOptions="Center"
                   Padding="18"
                   CornerRadius="14"
                   HasShadow="False"
                   BorderColor="{StaticResource Outline}"
                   BackgroundColor="{StaticResource Surface}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Acceso"
                           FontSize="{StaticResource FontHeadline}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Ingrese usuario y contraseña"
                           FontSize="{StaticResource FontBody}"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalTextAlignment="Center" />
                    <Entry x:Name="txtUser"
                           Placeholder="Usuario"
                           ReturnType="Next" />
                    <Entry x:Name="txtPassword"
                           Placeholder="Contraseña"
                           IsPassword="True"
                           ReturnType="Go"
                           Completed="OnLoginClicked" />
                    <Button Text="Entrar"
                            Clicked="OnLoginClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource OnPrimary}"
                            CornerRadius="10" />
                    <Label x:Name="lblMessage"
                           IsVisible="False"
                           TextColor="{StaticResource Error}"
                           FontSize="{StaticResource FontBody}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </ContentPage.Content>
</ContentPage>
