<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Appinventario.Views.ModuleAdminPage"
             Title="Gestión de módulos"
             BackgroundColor="{StaticResource Canvas}">
    <ContentPage.Content>
        <Grid Padding="12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Frame Grid.Row="0"
                   Padding="12"
                   CornerRadius="12"
                   HasShadow="False"
                   BorderColor="{StaticResource Outline}"
                   BackgroundColor="{StaticResource Surface}">
                <Label Text="Active o desactive módulos para los usuarios. Sistema siempre puede entrar a esta pantalla."
                       TextColor="{StaticResource TextPrimary}"
                       FontSize="{StaticResource FontBody}" />
            </Frame>

            <CollectionView Grid.Row="1"
                            x:Name="listModules"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="12"
                                BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Outline}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding Key}"
                                           FontSize="{StaticResource FontCaption}"
                                           TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding IsEnabled, Mode=TwoWay}"
                                        Toggled="OnModuleToggled" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Grid.Row="2"
                    Text="Aplicar cambios"
                    Clicked="OnApplyClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource OnPrimary}"
                    CornerRadius="10" />
        </Grid>
    </ContentPage.Content>
</ContentPage>
