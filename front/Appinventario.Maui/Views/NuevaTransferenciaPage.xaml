<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Appinventario.Views.NuevaTransferenciaPage"
             Visual="Material"
             Title="Transferencia"
             BackgroundColor="{StaticResource Canvas}">
    <ContentPage.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="{StaticResource FontCaption}"/>
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style x:Key="InputField" TargetType="Entry">
            <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
            <Setter Property="HeightRequest" Value="48"/>
            <Setter Property="BackgroundColor" Value="{StaticResource Surface}"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="10,8,10,18" Spacing="10">
                <Grid RowDefinitions="Auto,Auto">
                    <HorizontalStackLayout Grid.Row="0" Spacing="6">
                        <Label x:Name="tituloTransferencia"
                               Text="Transferencia"
                               FontSize="{StaticResource FontTitle}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>
                    </HorizontalStackLayout>
                    <Label x:Name="subtituloSucursal"
                           Grid.Row="1"
                           Text="Sucursal: "
                           FontSize="{StaticResource FontCaption}"
                           TextColor="{StaticResource TextPrimary}"/>
                </Grid>

                <Label x:Name="estadoConexion"
                       IsVisible="False"
                       Padding="8"
                       FontSize="{StaticResource FontCaption}"
                       TextColor="{StaticResource Warning}"
                       BackgroundColor="{StaticResource WarningContainer}"/>

                <Border BackgroundColor="{StaticResource Surface}" Padding="10">
                    <Border.StrokeShape>
                        <shapes:RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="6">
                                <Label x:Name="toggleCabeceraText"
                                       Text="Ocultar datos de cabecera"
                                       FontSize="{StaticResource FontBody}"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label x:Name="toggleCabeceraIcon"
                                   Grid.Column="1"
                                   Text="^"
                                   FontSize="{StaticResource FontBody}"
                                   TextColor="{StaticResource TextSecondary}"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ToggleCabecera_Tapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>

                        <VerticalStackLayout x:Name="cabeceraPanel"
                                             IsVisible="True"
                                             Spacing="9">
                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8"
                                  RowSpacing="4">
                                <Label Text="Número" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
                                <Label Text="Documento origen" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldLabel}"/>
                                <Entry x:Name="numero"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Automático"
                                       IsReadOnly="True"
                                       Style="{StaticResource InputField}"/>
                                <Entry x:Name="documentoOrigen"
                                       Grid.Row="1"
                                       Grid.Column="1"
                                       Placeholder="Documento"
                                       Style="{StaticResource InputField}"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8"
                                  RowSpacing="4">
                                <Label Text="Fecha" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
                                <Label Text="Fecha de emisión" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="fecha" Grid.Row="1" Grid.Column="0" FontSize="{StaticResource FontCaption}"/>
                                <DatePicker x:Name="fechaEmision" Grid.Row="1" Grid.Column="1" FontSize="{StaticResource FontCaption}"/>
                            </Grid>

                            <Label Text="Sucursal" Style="{StaticResource FieldLabel}"/>
                            <Picker x:Name="listaSucursal"
                                    ItemDisplayBinding="{Binding Nombre}"
                                    FontSize="{StaticResource FontCaption}"
                                    SelectedIndexChanged="Sucursal_SelectedIndexChanged"/>

                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8"
                                  RowSpacing="4">
                                <Label Text="Despacho" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
                                <Label Text="Lote" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldLabel}"/>
                                <Picker x:Name="despacho"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        ItemDisplayBinding="{Binding Descripcion}"
                                        FontSize="{StaticResource FontCaption}"/>
                                <Picker x:Name="lote"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        ItemDisplayBinding="{Binding Lote}"
                                        FontSize="{StaticResource FontCaption}"/>
                            </Grid>

                            <Label Text="Observación" Style="{StaticResource FieldLabel}"/>
                            <Entry x:Name="observacion" Style="{StaticResource InputField}"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Corrección" Grid.Column="0" FontSize="{StaticResource FontCaption}" TextColor="{StaticResource TextPrimary}"/>
                                <Switch x:Name="transferenciaCorreccion" Grid.Column="1"/>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="{StaticResource Primary}"
                        StrokeDashArray="2,2"
                        BackgroundColor="{StaticResource Surface}"
                        Padding="10,9">
                    <Border.StrokeShape>
                        <shapes:RoundRectangle CornerRadius="7"/>
                    </Border.StrokeShape>
                    <Label Text="Agregar artículo manualmente"
                           FontSize="{StaticResource FontBody}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ToggleEscaneo_Tapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <Border x:Name="escaneoPanel"
                        IsVisible="False"
                        BackgroundColor="{StaticResource Surface}"
                        Padding="10">
                    <Border.StrokeShape>
                        <shapes:RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Código de barra" Style="{StaticResource FieldLabel}"/>
                        <Entry x:Name="codigoBarra"
                               Placeholder="Código de barra"
                               TextChanged="CodigoBarra_TextChanged"
                               Completed="CodigoBarra_Completed"
                               Style="{StaticResource InputField}"/>
                        <Grid ColumnDefinitions="80,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="8">
                            <Label Text="Caja" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
                            <Label Text="Cantidad" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldLabel}"/>
                            <Entry x:Name="cajaDetalle" Grid.Row="1" Grid.Column="0" Text="1" Keyboard="Numeric" Style="{StaticResource InputField}"/>
                            <Entry x:Name="cantidadDetalle" Grid.Row="1" Grid.Column="1" Text="1" Keyboard="Numeric" Style="{StaticResource InputField}"/>
                        </Grid>
                        <Button Text="Agregar"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource OnPrimary}"
                                Clicked="AgregarDetalle_Clicked"/>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="2,8,2,0">
                    <Label Text="Productos escaneados"
                           FontSize="{StaticResource FontBody}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           LineBreakMode="NoWrap"/>
                    <Label x:Name="resumenReferencias"
                           Grid.Row="1"
                           Text="0 referencias en lista"
                           FontSize="{StaticResource FontCaption}"
                           TextColor="{StaticResource TextSecondary}"/>
                        <HorizontalStackLayout Grid.Column="1" Grid.RowSpan="2" Spacing="8" VerticalOptions="Center">
                            <Label Text="Caja" FontSize="{StaticResource FontCaption}" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                            <Button x:Name="box1Button"
                                    Text="1"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    Padding="0"
                                    CornerRadius="24"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="{StaticResource OnPrimary}"
                                    FontSize="{StaticResource FontSubtitle}"
                                    FontAttributes="Bold"
                                    Clicked="BoxButton_Clicked"/>
                            <Button x:Name="box2Button"
                                    Text="2"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    Padding="0"
                                    CornerRadius="24"
                                    BackgroundColor="{StaticResource SurfaceMuted}"
                                    TextColor="{StaticResource TextSecondary}"
                                    FontSize="{StaticResource FontSubtitle}"
                                    FontAttributes="Bold"
                                    Clicked="BoxButton_Clicked"/>
                            <Button x:Name="box3Button"
                                    Text="3"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    Padding="0"
                                    CornerRadius="24"
                                    BackgroundColor="{StaticResource SurfaceMuted}"
                                    TextColor="{StaticResource TextSecondary}"
                                    FontSize="{StaticResource FontSubtitle}"
                                    FontAttributes="Bold"
                                    Clicked="BoxButton_Clicked"/>
                        </HorizontalStackLayout>
                </Grid>

                <CollectionView x:Name="detalleGrid"
                                HeightRequest="330">
                    <CollectionView.EmptyView>
                        <Label Text="Sin productos escaneados"
                               Margin="8,25"
                               FontSize="{StaticResource FontBody}"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2,5"
                                    Padding="10"
                                    BackgroundColor="{StaticResource Surface}">
                                <Border.StrokeShape>
                                    <shapes:RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="32,*">
                                        <Border BackgroundColor="{StaticResource Brand}"
                                                WidthRequest="24"
                                                HeightRequest="24"
                                                VerticalOptions="Start">
                                            <Border.StrokeShape>
                                                <shapes:RoundRectangle CornerRadius="3"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Item}" FontSize="{StaticResource FontCaption}" TextColor="{StaticResource OnPrimary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Nombre}" FontSize="{StaticResource FontCaption}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                            <Label Text="{Binding Referencia}" FontSize="{StaticResource FontCaption}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*">
                                        <VerticalStackLayout>
                                            <Label Text="Código de barra" FontSize="{StaticResource FontCaption}" TextColor="{StaticResource TextSecondary}"/>
                                            <Label Text="{Binding CodigoBarra}" FontSize="{StaticResource FontBody}" TextColor="{StaticResource TextPrimary}"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="Referencia" FontSize="{StaticResource FontCaption}" TextColor="{StaticResource TextSecondary}"/>
                                            <Label Text="{Binding Referencia}" FontSize="{StaticResource FontBody}" TextColor="{StaticResource TextPrimary}"/>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                                        <Border Padding="8,4" Stroke="{StaticResource Primary}" BackgroundColor="{StaticResource Surface}" VerticalOptions="Center" HorizontalOptions="Start">
                                            <Border.StrokeShape>
                                                <shapes:RoundRectangle CornerRadius="5"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding NumeroCaja, StringFormat='Caja N: {0}'}" FontSize="{StaticResource FontCaption}" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                                        </Border>
                                        <Border Grid.Column="1"
                                                Stroke="{StaticResource OutlineStrong}"
                                                StrokeThickness="1"
                                                Padding="0"
                                                BackgroundColor="{StaticResource Surface}">
                                            <Border.StrokeShape>
                                                <shapes:RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <HorizontalStackLayout Spacing="0">
                                                <Button Text="−"
                                                        WidthRequest="48"
                                                        HeightRequest="48"
                                                        Padding="0"
                                                        CornerRadius="0"
                                                        FontSize="{StaticResource FontTitle}"
                                                        BackgroundColor="{StaticResource SurfaceMuted}"
                                                        TextColor="{StaticResource TextPrimary}"
                                                        CommandParameter="{Binding .}"
                                                        Clicked="RestarCantidad_Clicked"/>
                                                <Label Text="{Binding Cantidad}"
                                                       WidthRequest="44"
                                                       FontSize="{StaticResource FontSubtitle}"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextPrimary}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center"/>
                                                <Button Text="+"
                                                        WidthRequest="48"
                                                        HeightRequest="48"
                                                        Padding="0"
                                                        CornerRadius="0"
                                                        FontSize="{StaticResource FontTitle}"
                                                        BackgroundColor="{StaticResource SurfaceMuted}"
                                                        TextColor="{StaticResource TextPrimary}"
                                                        CommandParameter="{Binding .}"
                                                        Clicked="SumarCantidad_Clicked"/>
                                            </HorizontalStackLayout>
                                        </Border>
                                        <Button Grid.Column="2"
                                                Text="Quitar"
                                                HeightRequest="48"
                                                Padding="8,0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource Error}"
                                                FontSize="{StaticResource FontBody}"
                                                CommandParameter="{Binding .}"
                                                Clicked="EliminarDetalle_Clicked"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1"
                BackgroundColor="{StaticResource Surface}"
                Padding="10,8"
                Stroke="{StaticResource Outline}">
            <VerticalStackLayout Spacing="7">
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="8">
                    <Label Text="Total caja 1" Grid.Row="0" Grid.Column="0" FontSize="{StaticResource FontCaption}" TextColor="{StaticResource TextPrimary}"/>
                    <Label Text="Cantidad total" Grid.Row="0" Grid.Column="1" FontSize="{StaticResource FontCaption}" TextColor="{StaticResource TextPrimary}"/>
                    <Entry x:Name="totalCaja" Grid.Row="1" Grid.Column="0" IsReadOnly="True" HorizontalTextAlignment="Center" FontAttributes="Bold" Style="{StaticResource InputField}"/>
                    <Entry x:Name="cantidadTotal" Grid.Row="1" Grid.Column="1" IsReadOnly="True" HorizontalTextAlignment="Center" FontAttributes="Bold" Style="{StaticResource InputField}"/>
                </Grid>
                <Grid ColumnDefinitions="2*,*" ColumnSpacing="8">
                    <Button x:Name="Guardar"
                            Text="Guardar"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource OnPrimary}"
                            FontSize="{StaticResource FontBody}"
                            FontAttributes="Bold"
                            Clicked="Guardar_Clicked"/>
                    <Button x:Name="Cancelar"
                            Grid.Column="1"
                            Text="Borrador"
                            BackgroundColor="{StaticResource Surface}"
                            TextColor="{StaticResource TextPrimary}"
                            FontSize="{StaticResource FontBody}"
                            Clicked="Cancelar_Clicked"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
