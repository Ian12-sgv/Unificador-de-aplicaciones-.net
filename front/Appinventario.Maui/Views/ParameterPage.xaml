<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Appinventario.Views.NewItemPage"
             xmlns:local="clr-namespace:Appinventario.Controls"
             Shell.PresentationMode="ModalAnimated"
             Title="Parámetros"
             IsVisible="{Binding SelectCommand}"  >
    <ContentPage.Content>
        <StackLayout Spacing="3" Padding="15" >
            <Label Text="{Binding Id, Mode=TwoWay}" 
                   FontSize="{StaticResource FontSubtitle}" 
                   IsVisible="false"/>
            <Label Text="Dirección del servidor" 
                   FontSize="{StaticResource FontSubtitle}" />
            <local:RoundedEntry  Placeholder="Ej.: 192.168.0.135:5001" 
                                 Text="{Binding IP, Mode=TwoWay}" 
                                 FontSize="{StaticResource FontSubtitle}"
                                 Keyboard="Url"/>
            <Label Text="La prueba verifica la conexión con el servidor, sin consultar la base de datos."
                   FontSize="{StaticResource FontCaption}" />
            <Label Text=" " />
            <StackLayout Orientation="Horizontal">
                <Label Text="¿Usar ID único al procesar?" />
                <CheckBox x:Name="chkImei" IsChecked="{Binding Idimei}"/>
            </StackLayout>
            <VerticalStackLayout Spacing="8">
                <Button Text="Guardar"
                        Command="{Binding SaveCommand}" />
                <Button Text="Probar conexión"
                        Clicked="OnButtonClicked"
                        BackgroundColor="{StaticResource SurfaceMuted}"
                        TextColor="{StaticResource Brand}" />
                <Button Text="Cancelar"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
            <Label x:Name="lblMessage" 
                   Text="{Binding Message, Mode=TwoWay}" 
                   FontSize="{StaticResource FontSubtitle}" 
                   IsVisible="true"/>
            <Label Text="{Binding Sucursal, Mode=TwoWay}"
                   FontSize="{StaticResource FontSubtitle}" 
                   IsVisible="true"/>
        </StackLayout>
    </ContentPage.Content>
    
</ContentPage>

