<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Appinventario.Views.TomaFisicaDetallePage">
    <Grid RowDefinitions="*,Auto" RowSpacing="0">
        <CollectionView x:Name="ListTomaDetalle"
                        Grid.Row="0"
                        SelectionMode="Single"
                        SelectionChanged="itemClicked">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,48,96"
                          ColumnSpacing="8"
                          Padding="6,8"
                          BackgroundColor="{StaticResource Canvas}">
                        <Label Grid.Column="0"
                               Text="{Binding Nombre}"
                               FontSize="{StaticResource FontBody}"
                               LineBreakMode="WordWrap"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding Cantidad}"
                               FontSize="{StaticResource FontSubtitle}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="2"
                               Text="{Binding CodigoBarra}"
                               FontSize="{StaticResource FontBody}"
                               HorizontalTextAlignment="End"
                               LineBreakMode="WordWrap"
                               TextColor="{StaticResource Price}"
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="1"
              Padding="8,10"
              BackgroundColor="{StaticResource Surface}">
            <Label x:Name="lblExistencia"
                   Text="TOTAL CANTIDAD: 0"
                   FontSize="{StaticResource FontHeadline}"
                   FontAttributes="Bold"
                   HorizontalOptions="End"
                   TextColor="{StaticResource Price}" />
        </Grid>
    </Grid>
</ContentPage>