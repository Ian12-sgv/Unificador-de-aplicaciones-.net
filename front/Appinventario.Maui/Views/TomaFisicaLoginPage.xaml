<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Appinventario.Views.TomaFisicaLoginPage"
             Title="Toma física"
             BackgroundColor="{StaticResource Canvas}">
    <Grid Padding="24">
        <Border VerticalOptions="Center"
                Padding="20"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource Outline}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="13">
                <Image Source="barcodescanner.png"
                       HeightRequest="54"
                       Aspect="AspectFit" />
                <Label Text="Toma física"
                       FontSize="{StaticResource FontHeadline}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Ingrese sus credenciales de inventario"
                       FontSize="{StaticResource FontBody}"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="lblServidor"
                       FontSize="{StaticResource FontCaption}"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center" />
                <Entry x:Name="txtUsuario"
                       Placeholder="Usuario"
                       ReturnType="Next"
                       Completed="OnUsuarioCompleted" />
                <Entry x:Name="txtPassword"
                       Placeholder="Contraseña"
                       IsPassword="True"
                       ReturnType="Go"
                       Completed="OnPasswordCompleted" />
                <Button x:Name="btnIngresar"
                        Text="Ingresar"
                        Clicked="OnIngresarClicked"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource OnPrimary}"
                        CornerRadius="10" />
                <ActivityIndicator x:Name="indicador"
                                   IsVisible="False"
                                   IsRunning="False"
                                   Color="{StaticResource Primary}" />
                <Label x:Name="lblMensaje"
                       IsVisible="False"
                       TextColor="{StaticResource Error}"
                       FontSize="{StaticResource FontBody}"
                       HorizontalTextAlignment="Center" />
                <Label Text="La dirección se administra únicamente desde Parámetros en el menú."
                       FontSize="{StaticResource FontCaption}"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
