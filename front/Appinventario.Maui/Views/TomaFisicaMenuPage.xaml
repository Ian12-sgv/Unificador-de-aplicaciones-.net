<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Appinventario.Views.TomaFisicaMenuPage"
             Title="Toma física"
             BackgroundColor="{StaticResource Canvas}">
    <Grid Padding="18" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <VerticalStackLayout Grid.Row="0" Spacing="3">
            <Label Text="Seleccione el tipo de toma"
                   FontSize="{StaticResource FontHeadline}"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" />
            <Label x:Name="lblUsuario"
                   FontSize="{StaticResource FontBody}"
                   TextColor="{StaticResource TextSecondary}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1"
                             VerticalOptions="Center"
                             Spacing="16">
            <Button x:Name="btnToma1" Text="Toma física 1"
                    FontSize="{StaticResource FontTitle}"
                    HeightRequest="82"
                    Clicked="OnToma1Clicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource OnPrimary}"
                    CornerRadius="14" />
            <Button x:Name="btnToma2" Text="Toma física 2"
                    FontSize="{StaticResource FontTitle}"
                    HeightRequest="82"
                    Clicked="OnToma2Clicked"
                    BackgroundColor="{StaticResource Brand}"
                    TextColor="{StaticResource OnPrimary}"
                    CornerRadius="14" />
        </VerticalStackLayout>

        <Button Grid.Row="2"
                Text="Cerrar sesión de Toma física"
                Clicked="OnCerrarSesionClicked"
                BackgroundColor="Transparent"
                TextColor="{StaticResource Error}" />
    </Grid>
</ContentPage>
