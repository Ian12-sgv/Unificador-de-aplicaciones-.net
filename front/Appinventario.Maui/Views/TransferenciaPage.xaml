<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Appinventario.Views.TransferenciaPage"
             Visual="Material"
             Title="Transferencias"
             BackgroundColor="{StaticResource Canvas}">
    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Surface}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="StrokeThickness" Value="0"/>
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <shapes:RoundRectangle CornerRadius="4"/>
                </Setter.Value>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="12,14,12,24" Spacing="16">
            <Grid>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Bienvenido,"
                           FontSize="{StaticResource FontCaption}"
                           TextColor="{StaticResource TextPrimary}"/>
                    <Label Text="Portal de Transferencias"
                           FontSize="{StaticResource FontTitle}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"/>
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="8">
                <Border Style="{StaticResource Card}"
                        Padding="8">
                    <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="3">
                            <Ellipse WidthRequest="10" HeightRequest="10" Fill="{StaticResource Warning}" VerticalOptions="Center"/>
                            <Label Text="Guardadas"
                                   FontSize="{StaticResource FontCaption}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label x:Name="abiertasNumero"
                               Text="0"
                               FontSize="{StaticResource FontHeadline}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource Card}"
                        Padding="8">
                    <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="3">
                            <Ellipse WidthRequest="10" HeightRequest="10" Fill="{StaticResource Primary}" VerticalOptions="Center"/>
                            <Label Text="Aprobadas"
                                   FontSize="{StaticResource FontCaption}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label x:Name="procesadasNumero"
                               Text="0"
                               FontSize="{StaticResource FontHeadline}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource Card}"
                        Padding="8">
                    <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="3">
                            <Ellipse WidthRequest="10" HeightRequest="10" Fill="{StaticResource Info}" VerticalOptions="Center"/>
                            <Label Text="Exportadas"
                                   FontSize="{StaticResource FontCaption}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label x:Name="exportadasNumero"
                               Text="0"
                               FontSize="{StaticResource FontHeadline}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <VerticalStackLayout Spacing="10">
                <Label Text="Acciones rápidas"
                       FontSize="{StaticResource FontSubtitle}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"/>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="10">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="6"
                                             HorizontalOptions="Center">
                            <Label Text="Nueva"
                                   FontSize="{StaticResource FontSubtitle}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Crear transferencia"
                                   FontSize="{StaticResource FontCaption}"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="NuevaCard_Tapped"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="6"
                                             HorizontalOptions="Center">
                            <Label Text="Historial"
                                   FontSize="{StaticResource FontSubtitle}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Ver transferencias"
                                   FontSize="{StaticResource FontCaption}"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="HistorialCard_Tapped"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
